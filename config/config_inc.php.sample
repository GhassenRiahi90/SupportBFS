<?php
/**
 * Support BFS — Modèle de configuration MantisBT
 *
 * Copier ce fichier vers config_inc.php sur le serveur de production
 * (via cPanel File Manager ou FTP) et renseigner les valeurs sensibles.
 *
 * NE JAMAIS versionner config_inc.php (contient identifiants DB et SMTP).
 */

# --- Base de données (cPanel → MySQL Databases) ---
# Base partagée avec WordPress (préfixe WP : DfZDxQVf_) — tables MantisBT : mantis_*_table
$g_hostname          = 'localhost';
$g_db_username       = 'bfstn1_mantis';   # utilisateur dédié recommandé (voir DEPLOIEMENT.md)
$g_db_password       = 'MOT_DE_PASSE_MYSQL';
$g_database_name     = 'bfstn1_wp_x6lov';
$g_db_type           = 'mysqli';
$g_db_table_prefix   = 'mantis';           # → tables mantis_bug_table, mantis_user_table, etc.

# --- Sécurité ---
# Générer une chaîne aléatoire d'au moins 16 caractères, unique à cette installation
$g_crypto_master_salt = 'CHANGER_CETTE_VALEUR_ALEATOIRE';

# --- URL et identité BFS ---
$g_path           = 'https://support.bfs.tn/';
$g_window_title   = 'Support BFS';
$g_logo_image     = 'plugins/BfsPortal/assets/img/bfs-logo.png';
$g_favicon_image  = 'plugins/BfsPortal/assets/img/favicon.ico';
$g_logo_url       = 'my_view_page.php';
$g_show_version   = OFF;
$g_font_family    = 'Source Sans 3, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif';
$g_copyright_statement = 'Business Financial Solutions — Portail support clients';

# --- Langue ---
$g_default_language = 'french';

# --- Cloisonnement clients (projets privés par défaut) ---
# Voir ONBOARDING_CLIENT.md — un projet MantisBT = un client, pas une solution.
$g_default_project_view_status = VS_PRIVATE;
$g_default_bug_view_status     = VS_PRIVATE;
$g_private_project_threshold   = DEVELOPER;   # équipe BFS (≥ Developer) voit tous les projets privés

# --- Workflow BFS (statuts / criticité) ---
$g_status_enum_string   = '10:nouveau,20:en_attente_client,30:pris_en_charge,40:confirme,50:en_cours,80:resolu,90:ferme';
$g_severity_enum_string = '10:information,50:mineur,60:majeur,80:bloquant';
$g_status_colors = array(
	'nouveau'           => '#A8B2BA',
	'en_attente_client' => '#FFB74D',
	'pris_en_charge'    => '#4FA8D8',
	'confirme'          => '#4FA8D8',
	'en_cours'          => '#E65100',
	'resolu'            => '#2E7D32',
	'ferme'             => '#1B5E20',
);

# --- Accès anonyme / inscription ---
$g_allow_signup             = OFF;
$g_allow_anonymous_login    = OFF;
$g_anonymous_account        = '';

# --- Emails (boîte support@bfs.tn créée dans cPanel → Email Accounts) ---
$g_phpMailer_method     = PHPMAILER_METHOD_SMTP;
$g_smtp_host            = 'mail.bfs.tn';
$g_smtp_port            = 465;
$g_smtp_connection_mode = 'ssl';
$g_smtp_username        = 'support@bfs.tn';
$g_smtp_password        = 'MOT_DE_PASSE_BOITE_EMAIL';

$g_webmaster_email      = 'support@bfs.tn';
$g_from_email           = 'support@bfs.tn';
$g_return_path_email    = 'support@bfs.tn';
$g_administrator_email  = 'support@bfs.tn';
$g_from_name            = 'Support BFS';

# --- Pièces jointes (stockage disque recommandé en production) ---
$g_allow_file_upload    = ON;
$g_file_upload_method   = DISK;
$g_absolute_path_default_upload_folder = 'attachments/';

# --- Plugin BFS (thème, dashboard, emails) ---
$g_plugins_enabled = ON;
