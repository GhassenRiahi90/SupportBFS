# BFS Support — handler PHP EasyApache (mbstring inclus par défaut).
# Remplace alt-php82 si les extensions CloudLinux ne se chargent pas en web.
# php -- BEGIN BFS handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php
</IfModule>
# php -- END BFS handler, do not edit
